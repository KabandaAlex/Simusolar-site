# Tulima Solar — Apache rewrite & hardening (adjust RewriteBase if not in a subfolder)

RewriteEngine On
RewriteBase /simusolar_test/

DirectoryIndex index.php index.html

# Do NOT 301-redirect index.php?page=… or blog/*.php here — it causes ERR_TOO_MANY_REDIRECTS
# with ErrorDocument subrequests and some local Apache setups. Clean URLs still work via
# internal rewrites below; legacy ?page= and *.php URLs remain valid.

# =============================================================================
# HTTPS and WWW Configuration (uncomment in production)
# =============================================================================

# Force HTTPS (uncomment in production)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove www from URLs (uncomment in production)
# RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
# RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# =============================================================================
# PROTECTED DIRECTORIES - Exclude from rewriting
# =============================================================================
# These directories contain static files or direct-access PHP scripts
# that should NOT be routed through index.php
# NOTE: blog directory is NOT here because we want to route blog URLs

# Skip if requesting an existing file
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Skip if requesting an existing directory
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Skip rewriting for protected directories (check against REQUEST_URI which includes subfolder)
RewriteCond %{REQUEST_URI} ^/simusolar_test/admin/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/simusolar_test/assets/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/simusolar_test/includes/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/simusolar_test/config/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/simusolar_test/database/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/simusolar_test/install/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/simusolar_test/uploads/ [NC]
RewriteRule ^ - [L]

# =============================================================================
# API ROUTES - Direct access to api folder
# =============================================================================

RewriteCond %{REQUEST_URI} ^/simusolar_test/api/ [NC]
RewriteRule ^ - [L]

# =============================================================================
# BLOG ROUTES
# =============================================================================
# Blog URLs are routed to files in the /blog/ directory
# Order matters: more specific routes must come before catch-all blog post

# Blog main page: /blog or /blog/
RewriteRule ^blog/?$ blog/index.php [L,QSA]

# Blog category: /blog/category/{slug}
RewriteRule ^blog/category/([^/]+)/?$ blog/category.php?slug=$1 [L,QSA,NC]

# Blog tag: /blog/tag/{slug}
RewriteRule ^blog/tag/([^/]+)/?$ blog/tag.php?slug=$1 [L,QSA,NC]

# Blog archive: /blog/archive/{YYYY-MM}
RewriteRule ^blog/archive/([0-9]{4}-[0-9]{2})/?$ blog/archive.php?date=$1 [L,QSA]

# Blog author: /blog/author/{username}
RewriteRule ^blog/author/([^/]+)/?$ blog/author.php?username=$1 [L,QSA,NC]

# Blog post: /blog/{slug} (must come AFTER all specific blog routes)
RewriteRule ^blog/([^/]+)/?$ blog/post.php?slug=$1 [L,QSA,NC]

# =============================================================================
# MAIN PAGE ROUTES
# =============================================================================
# Clean URLs for main site pages - routed through index.php

# Home page (root)
RewriteRule ^$ index.php?page=home [L,QSA]

# About page
RewriteRule ^about/?$ index.php?page=about [L,QSA]
RewriteRule ^about-us/?$ index.php?page=about [L,QSA]

# Services page
RewriteRule ^services/?$ index.php?page=services [L,QSA]
RewriteRule ^our-services/?$ index.php?page=services [L,QSA]

# Projects page
RewriteRule ^projects/?$ index.php?page=projects [L,QSA]
RewriteRule ^our-projects/?$ index.php?page=projects [L,QSA]

# Contact page
RewriteRule ^contact/?$ index.php?page=contact [L,QSA]
RewriteRule ^contact-us/?$ index.php?page=contact [L,QSA]

# --- NEW: Forms & Applications ---
# Explicit routes to the new public pages in the /pages/ directory
RewriteRule ^distributor/?$ pages/distributor.php [L,QSA]
RewriteRule ^commercial/?$ pages/commercial.php [L,QSA]
# ---------------------------------

# Products page
RewriteRule ^products/?$ index.php?page=products [L,QSA]

# --- Product Category Pages ---
RewriteRule ^surface-pumps/?$ pages/surface-pumps.php [L,QSA]
RewriteRule ^submersible-pumps/?$ pages/submersible-pumps.php [L,QSA]
RewriteRule ^commercial-pumps/?$ pages/commercial-pumps.php [L,QSA]
# ------------------------------

# Careers/Job Portal
RewriteRule ^careers/?$ index.php?page=careers [L,QSA]
RewriteRule ^jobs/?$ index.php?page=careers [L,QSA]

# Quote page
RewriteRule ^quote/?$ index.php?page=quote [L,QSA]
RewriteRule ^get-a-quote/?$ index.php?page=quote [L,QSA]

# Legal pages
RewriteRule ^privacy/?$ index.php?page=privacy [L,QSA]
RewriteRule ^privacy-policy/?$ index.php?page=privacy [L,QSA]
RewriteRule ^terms/?$ index.php?page=terms [L,QSA]
RewriteRule ^terms-conditions/?$ index.php?page=terms [L,QSA]
RewriteRule ^cookies/?$ index.php?page=cookies [L,QSA]

# Sitemap
RewriteRule ^sitemap/?$ index.php?page=sitemap [L,QSA]

# Careers job detail — extensionless (must be before catch-all; careers/ is a real directory)
RewriteRule ^careers/job/?$ careers/job.php [L,QSA]
RewriteRule ^careers/job/([0-9]+)/?$ careers/job.php?id=$1 [L,QSA]
RewriteRule ^careers/job/([a-zA-Z0-9_-]+)/?$ careers/job.php?slug=$1 [L,QSA]

# =============================================================================
# CATCH-ALL ROUTE (Dynamic Pages)
# =============================================================================
# Last — nested slugs e.g. products/surface-pumps, who-we-are, campaign-lead
# Exclude /pages/… so /pages/foo.php is still served as the file when requested

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/simusolar_test/admin/ [NC]
RewriteCond %{REQUEST_URI} !^/simusolar_test/assets/ [NC]
RewriteCond %{REQUEST_URI} !^/simusolar_test/includes/ [NC]
RewriteCond %{REQUEST_URI} !^/simusolar_test/config/ [NC]
RewriteCond %{REQUEST_URI} !^/simusolar_test/database/ [NC]
RewriteCond %{REQUEST_URI} !^/simusolar_test/api/ [NC]
RewriteCond %{REQUEST_URI} !^/simusolar_test/blog/ [NC]
RewriteCond %{REQUEST_URI} !^/simusolar_test/uploads/ [NC]
RewriteCond %{REQUEST_URI} !^/simusolar_test/pages/ [NC]
RewriteCond %{REQUEST_URI} !^/simusolar_test/careers/ [NC]
RewriteRule ^([a-zA-Z0-9_/\-]+)/?$ index.php?page=$1 [L,QSA]

# =============================================================================
# ERROR DOCUMENTS
# =============================================================================
# Use absolute paths from web root (including subfolder)

ErrorDocument 404 /simusolar_test/index.php?page=404
ErrorDocument 403 /simusolar_test/index.php?page=404
ErrorDocument 500 /simusolar_test/index.php?page=500

# =============================================================================
# SECURITY HEADERS
# =============================================================================

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always unset X-Powered-CMS
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_php.c>
    php_flag expose_php Off
</IfModule>
<IfModule mod_php7.c>
    php_flag expose_php Off
</IfModule>
<IfModule mod_php8.c>
    php_flag expose_php Off
</IfModule>

# =============================================================================
# PERFORMANCE OPTIMIZATIONS
# =============================================================================

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # HTML
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# =============================================================================
# FILE PROTECTION
# =============================================================================

# Protect hidden files (Apache 2.4 syntax)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Protect configuration and database files (Apache 2.4 syntax)
<FilesMatch "\.(sql|ini|log|sh|md)$">
    Require all denied
</FilesMatch>

# Protect backup files (Apache 2.4 syntax)
<FilesMatch "~$">
    Require all denied
</FilesMatch>